{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "cd ../.. && npm run db:generate --workspace=@repo/database && npm run build --workspace=web"
    }
  },
  "crons": [
    {
      "path": "/api/cron/complaint-retention",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/media-cleanup",
      "schedule": "30 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}

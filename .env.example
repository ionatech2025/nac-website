# Copy to .env (never commit real secrets).

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://nac:nac@localhost:5432/nac?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Seeded Site Admin (Sprint 0). Change before any real deployment.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@nacuganda.org"
# Must be at least 12 characters. Use this exact value when signing in after seed.
ADMIN_PASSWORD="change-me-now-please"

# Optional: Vercel Blob for durable image uploads in production.
# Locally, images are stored under apps/web/public/uploads/ when unset.
# BLOB_READ_WRITE_TOKEN=

# Optional analytics salt for daily-rotating visitor hashes (falls back to AUTH_SECRET).
# ANALYTICS_SALT=

# Vercel Cron auth for /api/cron/complaint-retention (30-day complaint deletion, Q4).
# Set in Vercel project env; generate with: openssl rand -base64 32
# CRON_SECRET=
